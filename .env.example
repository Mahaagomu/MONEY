# Set these in Render Dashboard -> your Web Service -> Environment.
# Do NOT place this API key in the public website or upload it to GitHub.
SAFE_BROWSING_API_KEY=replace_with_your_Google_Safe_Browsing_API_key
# Generate a long random value and put the SAME value in the ESP8266 sketch.
DEVICE_KEY=replace_with_a_long_random_secret_value
# GitHub Pages origin only (no /MONEY/ path)
FRONTEND_ORIGINS=https://mahaagomu.github.io
